@model IReadOnlyList<Booking>
@{
	ViewData["Title"] = "Manage bookings";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 page-title-row">
	<div>
		<span class="eyebrow">CARELINE OPERATIONS</span>
		<h1 class="h2 mt-2 mb-0">Ambulance requests</h1>
	</div>
	<a asp-action="Index" class="text-link">Back to dashboard</a>
</div>
@if (Model.Count == 0)
{
	<p class="text-muted">No requests have been submitted.</p>
}
else
{
	<div class="table-responsive data-table-panel">
		<table class="table align-middle">
			<thead><tr><th>Request</th><th>Patient contact</th><th>Submitted</th><th>Transport</th><th>Status</th><th>Ambulance</th><th></th></tr></thead>
			<tbody>
				@foreach (var booking in Model)
				{
					<tr>
						<td>#@booking.Id</td>
						<td>
							<div>@(string.IsNullOrWhiteSpace(booking.User.FullName) ? "Name not provided" : booking.User.FullName)</div>
							<div class="small text-muted">@booking.User.Email</div>
							@if (!string.IsNullOrWhiteSpace(booking.User.PhoneNumber))
							{
								var phoneNumber = booking.User.PhoneNumber;
								var digits = new string(phoneNumber.Where(char.IsDigit).ToArray());
								var dialableNumber = phoneNumber.TrimStart().StartsWith("+", StringComparison.Ordinal) ? $"+{digits}" : digits;
								<a class="small" href="tel:@dialableNumber">@phoneNumber</a>
							}
							else
							{
								<div class="small text-muted">No phone provided</div>
							}
						</td>
						<td>@booking.BookingTime.ToLocalTime().ToString("g")</td>
						<td>@booking.RequestedTransport</td>
						<td>@booking.CurrentStatus</td>
						<td>@(booking.Ambulance?.VehicleNumber ?? "Not assigned")</td>
						<td><a asp-action="Booking" asp-route-id="@booking.Id">Review</a></td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}
