@model IReadOnlyList<Ambulance>
@{
	ViewData["Title"] = "Manage ambulances";
}

<div class="d-flex justify-content-between align-items-center mb-4">
	<h1 class="h2 mb-0">Ambulance fleet</h1>
	<a asp-action="CreateAmbulance" class="btn btn-primary">Add ambulance</a>
</div>
@if (TempData["StatusMessage"] is string message)
{
	<div class="alert alert-success" role="status">@message</div>
}
@if (Model.Count == 0)
{
	<p class="text-muted">No ambulances have been added.</p>
}
else
{
	<div class="table-responsive">
		<table class="table table-striped align-middle">
			<thead><tr><th>Vehicle</th><th>Transport</th><th>Status</th><th>Current location</th><th>Updated</th><th></th></tr></thead>
			<tbody>
				@foreach (var ambulance in Model)
				{
					<tr>
						<td>@ambulance.VehicleNumber</td>
						<td>@ambulance.TransportType</td>
						<td>@ambulance.Status</td>
						<td>@ambulance.CurrentLocation</td>
						<td>@ambulance.LastUpdated.ToLocalTime().ToString("g")</td>
						<td><a asp-action="EditAmbulance" asp-route-id="@ambulance.Id">Edit</a></td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}
<a asp-action="Index">Back to dashboard</a>
