@model Booking
@{
	ViewData["Title"] = $"Request #{Model.Id}";
}

<div class="row justify-content-center">
	<div class="col-lg-8 request-detail-panel">
		<div class="d-flex justify-content-between align-items-start mb-3">
			<div>
				<h1 class="h2">Request #@Model.Id</h1>
				<p class="text-muted">Submitted @Model.BookingTime.ToLocalTime().ToString("f")</p>
			</div>
			<span class="badge text-bg-secondary fs-6">@Model.CurrentStatus</span>
		</div>
		@if (TempData["StatusMessage"] is string statusMessage)
		{
			<div class="alert alert-success" role="status">@statusMessage</div>
		}
		@if (TempData["ErrorMessage"] is string errorMessage)
		{
			<div class="alert alert-warning" role="alert">@errorMessage</div>
		}
		@if (Model.CurrentStatus == BookingStatus.Pending)
		{
			<div class="alert alert-info" role="status">Your request has been received and is awaiting review.</div>
		}
		<dl class="row">
			<dt class="col-sm-4">Transport</dt>
			<dd class="col-sm-8">@Model.RequestedTransport</dd>
			<dt class="col-sm-4">Pickup location</dt>
			<dd class="col-sm-8">@Model.PickupLocation</dd>
			<dt class="col-sm-4">Destination</dt>
			<dd class="col-sm-8">@Model.Destination</dd>
			<dt class="col-sm-4">Emergency type</dt>
			<dd class="col-sm-8">@Model.EmergencyType</dd>
			<dt class="col-sm-4">Medical details</dt>
			<dd class="col-sm-8">@Model.MedicalProblem</dd>
			@if (!string.IsNullOrWhiteSpace(Model.PatientHistory))
			{
				<dt class="col-sm-4">Relevant history</dt>
				<dd class="col-sm-8">@Model.PatientHistory</dd>
			}
			@if (Model.Ambulance is not null)
			{
				<dt class="col-sm-4">Assigned vehicle</dt>
				<dd class="col-sm-8">@Model.Ambulance.VehicleNumber</dd>
			}
			@if (Model.EstimatedArrival is not null)
			{
				<dt class="col-sm-4">Estimated arrival</dt>
				<dd class="col-sm-8">@Model.EstimatedArrival.Value.ToLocalTime().ToString("f")</dd>
			}
		</dl>
		<div class="d-flex flex-wrap gap-2">
			<a asp-action="Track" asp-route-id="@Model.Id" class="btn btn-outline-primary">Track request updates</a>
			<a asp-action="Index" class="btn btn-outline-secondary">Back to my requests</a>
			<a asp-action="Create" class="btn btn-primary">New request</a>
			@if (Model.CurrentStatus == BookingStatus.Pending && !Model.AmbulanceId.HasValue)
			{
				<form asp-action="Cancel" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Cancel this pending request?');">
					<button type="submit" class="btn btn-outline-danger">Cancel request</button>
				</form>
			}
		</div>
	</div>
</div>
