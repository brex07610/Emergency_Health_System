@model AdminUsersViewModel
@{
	ViewData["Title"] = "Registered users";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
	<div>
		<span class="eyebrow">MOH ADMINISTRATION</span>
		<h1 class="h2 mt-2 mb-0">Registered users</h1>
	</div>
	<a asp-action="Index" class="btn btn-outline-secondary">Back to dashboard</a>
</div>

<form asp-action="Users" method="get" class="public-form-panel mb-4">
	<label for="search" class="form-label">Search by name, email, or phone</label>
	<div class="input-group">
		<input id="search" name="search" value="@Model.SearchTerm" class="form-control" type="search" maxlength="100" placeholder="Enter a name, email, or phone number" />
		<button type="submit" class="btn btn-primary">Search</button>
		@if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
		{
			<a asp-action="Users" class="btn btn-outline-secondary">Clear</a>
		}
	</div>
</form>

<p class="text-muted">@Model.Users.Count user(s) found.</p>
@if (Model.Users.Count == 0)
{
	<div class="alert alert-info" role="status">No users match this search.</div>
}
else
{
	<div class="table-responsive">
		<table class="table table-striped align-middle">
			<thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Requests</th></tr></thead>
			<tbody>
				@foreach (var user in Model.Users)
				{
					<tr>
						<td>@(string.IsNullOrWhiteSpace(user.FullName) ? "Not provided" : user.FullName)</td>
						<td>@user.Email</td>
						<td>@(string.IsNullOrWhiteSpace(user.PhoneNumber) ? "Not provided" : user.PhoneNumber)</td>
						<td>@user.BookingCount</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}
