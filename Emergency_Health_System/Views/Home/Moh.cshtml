@{
	ViewData["Title"] = "About this health system";
}

<section class="section-heading page-intro mb-4">
	<span class="eyebrow">ABOUT THE PROJECT</span>
	<h1 class="display-6 mt-2">A demonstration for coordinated ambulance requests</h1>
	<p class="text-muted">CareLine Health is a student-project prototype inspired by a Ministry of Health ambulance and patient-care workflow.</p>
</section>

<div class="row g-3">
	<div class="col-lg-7">
		<article class="feature-card h-100">
			<h2 class="h4">What the prototype demonstrates</h2>
			<p class="text-muted">Patients can create accounts, submit road or air transport requests, and follow status and ETA updates. An administrator can manage a demonstration vehicle fleet, review requests, and record assignment and status changes.</p>
			<p class="text-muted mb-0">Vehicle location in this version is a staff-entered update. There is no live GPS, dispatch integration, or connection to a hospital or government health service.</p>
		</article>
	</div>
	<div class="col-lg-5">
		<article class="feature-card h-100">
			<h2 class="h4">Health information</h2>
			<p class="text-muted">This site is not an official Ministry of Health service and does not provide medical advice or emergency response.</p>
			<p class="text-muted mb-0">For immediate help, contact the emergency services in your area directly. Use locally verified health resources for official guidance.</p>
		</article>
	</div>
</div>
