@{
	ViewData["Title"] = "Health and emergency tips";
}

<section class="section-heading page-intro mb-4">
	<span class="eyebrow">BE PREPARED</span>
	<h1 class="display-6 mt-2">Practical emergency-readiness tips</h1>
	<p class="text-muted">General preparation ideas for everyday safety—not a substitute for advice from qualified local professionals.</p>
</section>

<div class="row g-3">
	<div class="col-md-6">
		<article class="feature-card h-100">
			<span class="step-number">BEFORE AN EMERGENCY</span>
			<h2 class="h5 mt-3">Keep essential details accessible</h2>
			<ul class="text-muted mb-0">
				<li>Know how to contact your local emergency services.</li>
				<li>Keep important medicines, allergies, and medical contacts recorded for reference.</li>
				<li>Make sure your household knows its address and a clear meeting point.</li>
			</ul>
		</article>
	</div>
	<div class="col-md-6">
		<article class="feature-card h-100">
			<span class="step-number">WHEN REQUESTING HELP</span>
			<h2 class="h5 mt-3">Share clear, useful information</h2>
			<ul class="text-muted mb-0">
				<li>Give the exact pickup location and a helpful landmark if available.</li>
				<li>Describe the situation clearly and mention known allergies or relevant history.</li>
				<li>Follow instructions from your local emergency dispatcher or medical professionals.</li>
			</ul>
		</article>
	</div>
	<div class="col-md-6">
		<article class="feature-card h-100">
			<span class="step-number">WHILE WAITING</span>
			<h2 class="h5 mt-3">Follow professional instructions</h2>
			<p class="text-muted mb-0">Stay in contact with local emergency services when appropriate. Do not rely on this prototype's request status or estimated arrival as confirmation that help has been dispatched.</p>
		</article>
	</div>
	<div class="col-md-6">
		<article class="feature-card h-100">
			<span class="step-number">IMPORTANT</span>
			<h2 class="h5 mt-3">This page is general information</h2>
			<p class="text-muted mb-0">It does not diagnose, treat, or provide individualized medical advice. For urgent situations, contact your local emergency number directly.</p>
		</article>
	</div>
</div>
